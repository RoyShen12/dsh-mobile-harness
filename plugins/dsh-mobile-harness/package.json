{
  "name": "dsh-mobile-harness",
  "version": "1.0.0",
  "type": "module",
  "description": "DSH Mobile Harness — bring your desktop DeepSeek Harness session to your phone: native Android app, QR pairing, four network entries, device admission control.",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "remote-access",
    "cloudflare-tunnel",
    "tailscale",
    "android",
    "remote-control",
    "device-admission"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
