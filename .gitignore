# dependencies
node_modules/
app/node_modules/

# android build output
app/android/.gradle/
app/android/build/
app/android/app/build/
app/android/local.properties
app/android/capacitor-cordova-android-plugins/
# generated by `npx cap sync android` (server cap copy of app/www)
app/android/app/src/main/assets/public/

# local scratch space (test scripts, probes, temporary screenshots)
.research/
诊断包/

# internal working notes (Chinese runbooks full of machine-specific paths and live tunnel URLs)
docs/

# another plugin that lives in the same working copy, not part of DSH Mobile Harness
plugins/dsh-life-helper/

# local tools downloaded at first run (cloudflared.exe / tailscale msi, ~100 MB)
tools/bin/

# machine-local launcher config (tunnel hostnames, local paths)
tools/remote-config.json

# logs
*.log
build-log.txt

# a copy of cloudflared.exe kept next to the APK for offline sharing (52 MB)
app/dist/*.exe

# keep only the released APK in the repo; older builds live in GitHub Releases
app/dist/*.apk
!app/dist/dsh-mobile-harness-1.0.0.apk

